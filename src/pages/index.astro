---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TourProgress from '../components/TourProgress.astro';
import TourStage from '../components/TourStage.astro';
import SceneEntrada from '../components/SceneEntrada.astro';
import SceneFiscal from '../components/SceneFiscal.astro';
import SceneContable from '../components/SceneContable.astro';
import SceneLaboral from '../components/SceneLaboral.astro';
import SceneReuniones from '../components/SceneReuniones.astro';
import SceneContacto from '../components/SceneContacto.astro';
import ConsultaSection from '../components/ConsultaSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout>
  <SiteHeader surface="dark" />
  <TourProgress />

  <main id="contenido-principal" class="tour-main">
    <div class="tour-cinema">
      <TourStage />

      <div class="tour-chapters">
        <SceneEntrada />
        <SceneFiscal />
        <SceneContable />
        <SceneLaboral />
        <SceneReuniones />
        <SceneContacto />
      </div>
    </div>

    <ConsultaSection />
  </main>

  <SiteFooter hasTourRail={true} />
</Layout>

<script>
  import { mountTour } from '../scripts/tour';

  mountTour();
</script>
