---
import { SITE_META, TOUR_NAV } from '../data/scenes';
---

<footer class="site-footer">
  <div class="container container--tour site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__wordmark">
        <strong>{SITE_META.brandName}</strong> · {SITE_META.brandDescriptor}
      </p>
      <p class="site-footer__notice">{SITE_META.demoNotice}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Índice del recorrido">
      <ul class="site-footer__links">
        {
          TOUR_NAV.map((item) => (
            <li>
              <a href={`#${item.id}`} class="site-footer__link">
                <span class="site-footer__num">{item.number}</span>
                <span>{item.navLabel}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container container--tour site-footer__bottom">
    <p class="site-footer__meta">Fase 1 · Homepage editorial de recorrido arquitectónico</p>
    <a href="#entrada" class="site-footer__top">Volver a la entrada</a>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-offwhite);
    border-top: 1px solid var(--line-strong);
    padding-block: clamp(2.5rem, 5vw, 4rem) 2rem;
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--line-subtle);
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: start;
    }
  }

  .site-footer__wordmark {
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.65rem;
  }

  .site-footer__notice {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    max-width: 56ch;
    line-height: 1.6;
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 1.5rem;
  }

  @media (min-width: 480px) {
    .site-footer__links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .site-footer__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-secondary);
  }

  .site-footer__link:hover {
    color: var(--ink-primary);
  }

  .site-footer__num {
    font-variant-numeric: tabular-nums;
    color: var(--accent-terracotta-dark);
    font-weight: 600;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: 1.5rem;
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .site-footer__top {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--ink-primary);
  }

  .site-footer__top:hover {
    color: var(--accent-terracotta-dark);
  }
</style>
