---
import { SITE_META } from '../data/scenes';

interface Props {
  hasTourRail?: boolean;
}

const { hasTourRail = false } = Astro.props;
const containerClass = hasTourRail ? 'container container--tour' : 'container';
---

<footer class="site-footer">
  <div class={`${containerClass} site-footer__grid`}>
    <div class="site-footer__brand">
      <a href="/" class="site-footer__wordmark">
        <strong>{SITE_META.brandName}</strong>
        <span aria-hidden="true">·</span>
        <span>{SITE_META.brandDescriptor}</span>
      </a>
      <p class="site-footer__tagline">
        Asesoramiento fiscal, contable y laboral con trato directo, explicaciones claras y acompañamiento cercano.
      </p>
      <p class="site-footer__notice">
        Demo conceptual de asesoría familiar. Estructura y contenidos de demostración sin vinculación a un despacho real.
      </p>
    </div>

    <nav class="site-footer__col" aria-label="Áreas de servicio">
      <h2 class="site-footer__heading">Servicios</h2>
      <ul class="site-footer__list">
        <li><a href="/fiscal" class="site-footer__link">Asesoría Fiscal</a></li>
        <li><a href="/contable" class="site-footer__link">Asesoría Contable</a></li>
        <li><a href="/laboral" class="site-footer__link">Asesoría Laboral</a></li>
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Despacho">
      <h2 class="site-footer__heading">Despacho</h2>
      <ul class="site-footer__list">
        <li><a href="/" class="site-footer__link">Inicio · Recorrido</a></li>
        <li><a href="/nosotros" class="site-footer__link">Nosotros</a></li>
        <li><a href="/contacto" class="site-footer__link">Contacto</a></li>
      </ul>
    </nav>

    <div class="site-footer__col site-footer__contact">
      <h2 class="site-footer__heading">Contacto</h2>
      <p class="site-footer__contact-text">
        Primera conversación tranquila para conocer tu actividad y valorar cómo ayudarte.
      </p>
      <a href="/contacto" class="site-footer__cta">
        <span>Hablemos</span>
        <svg class="btn__icon btn__icon--right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="13 6 19 12 13 18" />
        </svg>
      </a>
    </div>
  </div>

  <div class={`${containerClass} site-footer__bottom`}>
    <p class="site-footer__meta">
      © 2026 {SITE_META.brandName} · {SITE_META.brandDescriptor}. Proyecto de demostración conceptual.
    </p>
    <a href="#contenido-principal" class="site-footer__top">Volver arriba</a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 4;
    background-color: var(--bg-offwhite);
    border-top: 1px solid var(--line-strong);
    padding-block: clamp(3rem, 6vw, 4.75rem) 2rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem 2rem;
    padding-bottom: clamp(2.25rem, 4vw, 3.25rem);
    border-bottom: 1px solid var(--line-subtle);
  }

  @media (min-width: 720px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1.55fr) repeat(2, minmax(0, 0.85fr)) minmax(0, 1.1fr);
      gap: 2.5rem 3rem;
    }
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .site-footer__wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    width: fit-content;
  }

  .site-footer__tagline {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    max-width: 38ch;
    line-height: 1.55;
  }

  .site-footer__notice {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    max-width: 44ch;
    line-height: 1.55;
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .site-footer__heading {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .site-footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .site-footer__link {
    font-size: var(--text-sm);
    color: var(--ink-primary);
    transition: color var(--dur-fast) var(--ease-architectural);
  }

  .site-footer__link:hover {
    color: var(--accent-terracotta-dark);
  }

  .site-footer__contact-text {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.55;
  }

  .site-footer__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: fit-content;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-primary);
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--ink-primary);
    transition:
      color var(--dur-fast) var(--ease-architectural),
      border-color var(--dur-fast) var(--ease-architectural);
  }

  .site-footer__cta:hover {
    color: var(--accent-terracotta-dark);
    border-color: var(--accent-terracotta-dark);
  }

  .site-footer__cta:hover .btn__icon--right {
    transform: translateX(3px);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: 1.5rem;
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .site-footer__top {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--ink-primary);
  }

  .site-footer__top:hover {
    color: var(--accent-terracotta-dark);
  }
</style>
