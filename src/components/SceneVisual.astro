---
import type { SceneVisualSpec } from '../data/scenes';

interface Props {
  spec: SceneVisualSpec;
  aspect?: 'hero' | 'vertical' | 'landscape';
  priority?: boolean;
  showCaption?: boolean;
}

const {
  spec,
  aspect = 'vertical',
  priority = false,
  showCaption = true,
} = Astro.props;
---

<figure class={`scene-visual scene-visual--${aspect}`} data-visual-frame>
  <div class="scene-visual__viewport" data-visual-media>
    <picture class="scene-visual__picture">
      <source media="(max-width: 1023px)" srcset={spec.imageMobile} type="image/webp" />
      <img
        src={spec.imageDesktop}
        alt={spec.alt}
        width={spec.width}
        height={spec.height}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding={priority ? 'sync' : 'async'}
        class="scene-visual__img"
        style={`object-position: ${spec.focalPoint};`}
      />
    </picture>
  </div>

  {showCaption && (
    <figcaption class="scene-visual__caption">
      <span class="scene-visual__code">{spec.code}</span>
      <span class="scene-visual__room">{spec.roomLabel}</span>
    </figcaption>
  )}
</figure>

<style>
  .scene-visual {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .scene-visual__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--surface-stone);
  }

  .scene-visual--hero .scene-visual__viewport {
    height: 100%;
    min-height: 100svh;
  }

  .scene-visual--vertical .scene-visual__viewport {
    aspect-ratio: 4 / 5;
  }

  .scene-visual--landscape .scene-visual__viewport {
    aspect-ratio: 16 / 10;
  }

  .scene-visual__picture,
  .scene-visual__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scene-visual__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    font-size: var(--text-xs);
    color: var(--ink-muted);
    letter-spacing: 0.04em;
  }

  .scene-visual__code {
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    font-variant-numeric: tabular-nums;
    color: var(--ink-secondary);
  }
</style>
