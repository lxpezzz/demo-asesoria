---
import SceneVisual from './SceneVisual.astro';
import { CONTABLE_SERVICES, SCENE_VISUALS } from '../data/scenes';
---

<section
  id="contable"
  class="scene scene--ivory scene-contable scene-anchor"
  aria-labelledby="titulo-contable"
  data-scene="contable"
  data-surface="dark"
  data-scrim="right"
>
  <div class="container container--tour">
    <div class="scene-contable__grid">
      <div class="scene-inline-media" data-scene-media>
        <SceneVisual spec={SCENE_VISUALS.contable} aspect="vertical" />
      </div>

      <div class="editorial-plate editorial-plate--right" data-scene-copy>
        <p class="eyebrow">02 / ASESORÍA CONTABLE</p>
        <h2 id="titulo-contable" class="display-h2">Tus números, siempre claros.</h2>
        <p class="lead">
          Organizamos y supervisamos la contabilidad de tu actividad para que tengas una visión más clara de tu negocio.
        </p>

        <ol class="contable-index" aria-label="Servicios de asesoría contable">
          {
            CONTABLE_SERVICES.map((item, index) => (
              <li class="contable-index__item">
                <span class="contable-index__code">02.{index + 1}</span>
                <span class="contable-index__title">{item.title}</span>
              </li>
            ))
          }
        </ol>

        <div>
          <a href="/contable" class="btn">
            <span>Conocer asesoría contable</span>
            <svg class="btn__icon btn__icon--right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="13 6 19 12 13 18" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
