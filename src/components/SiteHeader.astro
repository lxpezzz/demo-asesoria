---
import { SITE_META, TOUR_NAV } from '../data/scenes';
---

<header class="site-header" data-site-header data-surface="dark">
  <div class="container site-header__inner">
    <a href="#entrada" class="brand" aria-label={`${SITE_META.brandName} — ${SITE_META.brandDescriptor}, ir al inicio`}>
      <span class="brand__name">{SITE_META.brandName}</span>
      <span class="brand__sep" aria-hidden="true">/</span>
      <span class="brand__desc">{SITE_META.brandDescriptor}</span>
    </a>

    <nav class="site-nav" aria-label="Navegación principal">
      <ul class="site-nav__list">
        {
          TOUR_NAV.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                class="site-nav__link"
                data-nav-target={item.id}
              >
                {item.navLabel}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="#consulta" class="header-cta">Hablemos</a>
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Abrir menú de navegación"
        data-menu-toggle
      >
        <svg class="menu-toggle__icon menu-toggle__icon--open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true">
          <line x1="3" y1="8" x2="21" y2="8" />
          <line x1="3" y1="16" x2="21" y2="16" />
        </svg>
        <svg class="menu-toggle__icon menu-toggle__icon--close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true">
          <line x1="5" y1="5" x2="19" y2="19" />
          <line x1="19" y1="5" x2="5" y2="19" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav-drawer" class="mobile-drawer" hidden data-mobile-drawer>
    <nav class="container mobile-drawer__nav" aria-label="Navegación móvil">
      <ul class="mobile-drawer__list">
        {
          TOUR_NAV.map((item) => (
            <li class="mobile-drawer__item">
              <a href={`#${item.id}`} class="mobile-drawer__link" data-mobile-link>
                <span class="mobile-drawer__num">{item.number}</span>
                <span>{item.navLabel}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-drawer__footer">
        <a href="#consulta" class="btn btn--primary" data-mobile-link>
          Hablemos
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    min-height: var(--header-height);
    transition:
      background-color var(--dur-med) var(--ease-architectural),
      color var(--dur-med) var(--ease-architectural),
      border-color var(--dur-med) var(--ease-architectural);
  }

  .site-header[data-surface='dark'] {
    background-color: rgba(24, 22, 20, 0.72);
    color: var(--ink-on-dark);
    border-bottom: 1px solid rgba(245, 242, 236, 0.16);
  }

  .site-header[data-surface='light'] {
    background-color: rgba(245, 242, 236, 0.94);
    color: var(--ink-primary);
    border-bottom: 1px solid var(--line-subtle);
  }

  .site-header[data-surface='ivory'] {
    background-color: rgba(235, 230, 220, 0.95);
    color: var(--ink-primary);
    border-bottom: 1px solid var(--line-subtle);
  }

  .site-header__inner {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    white-space: nowrap;
  }

  .brand__name {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .brand__sep {
    opacity: 0.4;
    font-size: 0.85rem;
  }

  .brand__desc {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    opacity: 0.82;
  }

  @media (max-width: 420px) {
    .brand__sep,
    .brand__desc {
      display: none;
    }
  }

  .site-nav {
    display: none;
  }

  @media (min-width: 960px) {
    .site-nav {
      display: block;
    }
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1.1rem, 1.8vw, 2rem);
  }

  .site-nav__link {
    position: relative;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-block: 0.35rem;
    opacity: 0.78;
    transition: opacity var(--dur-fast) var(--ease-architectural);
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current='location'] {
    opacity: 1;
  }

  .site-nav__link[aria-current='location']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background-color: var(--accent-terracotta);
  }

  .site-header[data-surface='dark'] .site-nav__link[aria-current='location']::after {
    background-color: var(--wood-oak-light);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    transition:
      background-color var(--dur-fast) var(--ease-architectural),
      color var(--dur-fast) var(--ease-architectural),
      border-color var(--dur-fast) var(--ease-architectural);
  }

  .site-header[data-surface='dark'] .header-cta:hover {
    background-color: var(--ink-on-dark);
    color: var(--ink-primary);
    border-color: var(--ink-on-dark);
  }

  .site-header:not([data-surface='dark']) .header-cta:hover {
    background-color: var(--ink-primary);
    color: var(--ink-on-dark);
    border-color: var(--ink-primary);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 1px solid currentColor;
    cursor: pointer;
  }

  @media (min-width: 960px) {
    .menu-toggle {
      display: none;
    }
  }

  .menu-toggle__icon {
    width: 18px;
    height: 18px;
  }

  .menu-toggle[aria-expanded='false'] .menu-toggle__icon--close,
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon--open {
    display: none;
  }

  .mobile-drawer {
    background-color: var(--bg-offwhite);
    color: var(--ink-primary);
    border-top: 1px solid var(--line-subtle);
    border-bottom: 1px solid var(--line-strong);
  }

  .mobile-drawer[hidden] {
    display: none;
  }

  .mobile-drawer__nav {
    padding-block: 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-drawer__item {
    border-bottom: 1px solid var(--line-subtle);
  }

  .mobile-drawer__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.95rem;
    font-size: 1.05rem;
    font-weight: 500;
  }

  .mobile-drawer__num {
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--accent-terracotta-dark);
  }

  .mobile-drawer__footer .btn {
    width: 100%;
  }
</style>
